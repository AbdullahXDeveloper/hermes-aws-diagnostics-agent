{
  "mcpServers": {
    "aws-diagnostics": {
      "command": "aws-diagnostics-mcp",
      "args": ["serve"],
      "env": {
        "AWS_DIAGNOSTICS_AUTH_MODE": "auto",
        "AWS_DIAGNOSTICS_PROFILE": "diagnostics",
        "AWS_DIAGNOSTICS_ACCESS_MODE": "auto",
        "AWS_DIAGNOSTICS_ALLOW_ROOT": "false",
        "AWS_REGION": "us-east-1"
      }
    }
  }
}
